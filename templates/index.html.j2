<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>每日 AI 情报站</title>
  <meta name="description" content="让关注 AI 的人，在几分钟内了解近期值得关注的动态。每天自动更新。">
  <link rel="stylesheet" href="static/style.css">
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <div class="brand">
        <h1>每日 AI 情报站</h1>
        <p class="tagline">{{ today[:4] }}年{{ today[5:7]|int }}月{{ today[8:10]|int }}日 · 持续更新中</p>
      </div>
      <nav class="top-nav">
        <a href="index.html" class="active">今日</a>
        <a href="my-reading.html">我的阅读</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    {# 移动端：折叠的筛选区展开按钮 #}
    <button type="button" id="mobile-filter-btn" class="mobile-filter-btn" aria-expanded="false">🔍　筛选/搜索</button>

    {# ── 控件区：搜索 / 来源筛选 / 日期范围 / 清空 ── #}
    <section class="filters" aria-label="查找与筛选">
      <div class="search-wrap">
        <input id="search" type="search" placeholder="搜索关键词（标题或摘要）…" autocomplete="off">
        <button type="button" id="search-btn" class="search-btn">搜索</button>
      </div>
      <div class="filter-row">
        <label class="filter-label">来源
          <select id="source-filter">
            <option value="">全部</option>
            {% for s in source_filter %}
              <option value="{{ s.name }}">{{ s.name }}</option>
            {% endfor %}
          </select>
        </label>
        <div class="date-range" role="group" aria-label="日期范围">
          <button type="button" data-quick="today">今天</button>
          <button type="button" data-quick="7d" class="active">最近 7 天</button>
          <button type="button" data-quick="30d">最近 30 天</button>
          <button type="button" id="custom-trigger">自定义…</button>
        </div>
        <button type="button" id="clear-filters" class="clear-btn">清除条件</button>
      </div>

      {# 自定义日期弹出层（点"自定义…"才显示） #}
      <div class="date-popover" id="date-popover" hidden>
        <div class="popover-quick">
          <span class="popover-label">快捷：</span>
          <button type="button" data-pop-quick="yesterday">昨天</button>
          <button type="button" data-pop-quick="month">本月</button>
        </div>
        <div class="popover-range">
          <div class="popover-field">
            <span>起始</span>
            <select id="date-start-y" aria-label="起始年"></select>
            <span>年</span>
            <select id="date-start-m" aria-label="起始月"></select>
            <span>月</span>
            <select id="date-start-d" aria-label="起始日"></select>
            <span>日</span>
          </div>
          <div class="popover-field">
            <span>结束</span>
            <select id="date-end-y" aria-label="结束年"></select>
            <span>年</span>
            <select id="date-end-m" aria-label="结束月"></select>
            <span>月</span>
            <select id="date-end-d" aria-label="结束日"></select>
            <span>日</span>
          </div>
        </div>
        <div class="popover-actions">
          <button type="button" id="date-reset" class="clear-btn">清除</button>
          <button type="button" id="date-apply" class="search-btn">确定</button>
        </div>
      </div>
    </section>

    {# ── 热点区 ── #}
    {% set hot_items = items | selectattr('is_hot', 'true') | list %}
    {% if hot_items %}
    <section class="hot-zone" id="hot-zone" aria-label="近日热点">
      <h2>近日热点</h2>
      <div class="hot-list">
        {% for it in hot_items %}
          <article class="news-card hot" data-source="{{ it.source }}" data-title="{{ it.title }}" data-summary="{{ it.summary }}" data-link="{{ it.original_link }}" data-pub="{{ (it.published_at or '')[:10] }}">
            <div class="card-head">
              <span class="src-name">{{ it.source }}</span>
              <span class="sep">/</span>
              <time class="pub-time" datetime="{{ it.published_at or '' }}">{{ it.published_at|fmt_time }}</time>
              {% if it.points is not none and it.points != 0 %}<span class="sep">/</span><span class="meta-extra">{{ it.points }} 分</span>{% endif %}
              {% if it.comments is not none and it.comments != 0 %}<span class="sep">/</span><span class="meta-extra">{{ it.comments }} 评论</span>{% endif %}
            </div>
            <h3 class="card-title">
              <a href="{{ it.original_link }}" target="_blank" rel="noopener noreferrer">{{ it.title }}</a>
            </h3>
            {% if it.summary %}<p class="card-summary">{{ it.summary }}</p>{% endif %}
          </article>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    {# ── 新闻列表 ── #}
    <section class="news-list" aria-label="资讯列表">
      <h2>全部资讯（共 <span id="visible-count">{{ items|length }}</span> 条）</h2>
      <div id="news-container">
        {% for it in items %}
          <article class="news-card" data-source="{{ it.source }}" data-title="{{ it.title }}" data-summary="{{ it.summary }}" data-link="{{ it.original_link }}" data-pub="{{ (it.published_at or '')[:10] }}">
            <div class="card-head">
              <span class="src-name">{{ it.source }}</span>
              <span class="sep">/</span>
              <time class="pub-time" datetime="{{ it.published_at or '' }}">{{ it.published_at|fmt_time }}</time>
              {% if it.points is not none and it.points != 0 %}<span class="sep">/</span><span class="meta-extra">{{ it.points }} 分</span>{% endif %}
              {% if it.comments is not none and it.comments != 0 %}<span class="sep">/</span><span class="meta-extra">{{ it.comments }} 评论</span>{% endif %}
            </div>
            <h3 class="card-title">
              <a href="{{ it.original_link }}" target="_blank" rel="noopener noreferrer">{{ it.title }}</a>
            </h3>
            {% if it.summary %}<p class="card-summary">{{ it.summary }}</p>{% endif %}
            <div class="card-meta">
              {% if it.ai_generated %}<span class="ai-flag" title="摘要由AI生成">AI 摘要</span>{% endif %}
              <span class="lang-flag" title="原文语言">{{ '中文' if it.lang == 'zh' else '英文' }}</span>
              <button type="button" class="copy-md" data-title="{{ it.title }}" data-summary="{{ it.summary }}" data-link="{{ it.original_link }}" data-source="{{ it.source }}" data-time="{{ it.published_at|fmt_time }}">复制为 Markdown 引用</button>
            </div>
          </article>
        {% endfor %}
        <p id="empty-state" class="empty-state" hidden>没有匹配的资讯。试试<span class="link-clear">清除条件</span>或换一个关键词。</p>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>每日 AI 情报站 · 数据来源：
        {% for s in source_filter %}
          <a href="{{ s.name }}" target="_blank" rel="noopener noreferrer">{{ s.name }}</a>{% if not loop.last %} · {% endif %}
        {% endfor %}
      </p>
      <p class="footer-meta">
        {% if latest_run.fetched_at %}更新于 {{ latest_run.fetched_at|fmt_time }} ·{% endif %}
        每日自动更新{% for src, st in latest_run.status.items() %}{% if st.startswith('fail') %} · {{ src }} 采集失败{% endif %}{% endfor %} · 构建时间（UTC）：{{ built_at }} · 原文版权归原作者所有
      </p>
    </div>
  </footer>

  <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
  <script src="static/app.js" defer></script>
</body>
</html>
