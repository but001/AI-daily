<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>浏览历史 · 每日 AI 情报站</title>
  <link rel="stylesheet" href="../static/style.css">
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <div class="brand">
        <span class="brand-mark">AI</span>
        <div>
          <h1>浏览历史</h1>
          <p class="tagline">回看任意一天看了什么</p>
        </div>
      </div>
      <nav class="top-nav">
        <a href="../index.html">今日</a>
        <a href="index.html" class="active">浏览历史</a>
        <a href="../my-reading.html">我的阅读</a>
      </nav>
    </div>
  </header>

  <main class="wrap">
    <section class="archive-list" aria-label="浏览历史目录">
      <h2>按日期回看</h2>
      {% if dates %}
        <ul class="date-list">
          {% for d in dates %}
            <li><a href="{{ d }}.html">{{ d }}</a></li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="empty-state">还没有历史归档。每日自动更新时会生成当天的快照。</p>
      {% endif %}
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p><a href="../index.html">返回今日</a></p>
    </div>
  </footer>
</body>
</html>
